<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (http://) is blocked by default. It is permitted only for the
  explicit hosts below:
    - 137.23.47.128 : the Veyrion inference backend (OCI VM, plain HTTP for now)
    - 10.0.2.2      : the host machine as seen from the Android emulator
    - localhost / 127.0.0.1 : on-device local servers
  When the backend gets a domain + TLS, switch DARM_API_BASE to https:// and
  this host can be removed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">137.23.47.128</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
